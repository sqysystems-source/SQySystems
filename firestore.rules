rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isSuperAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }
    function validEmail(email) {
      return email is string && email.size() <= 254
        && email.matches('^[^/@\\s]+@[^/@\\s]+\\.[^/@\\s]{2,}$');
    }
    function validWebConfig(c) {
      return c is map
        && c.keys().hasOnly(['apiKey','authDomain','projectId','storageBucket','messagingSenderId','appId'])
        && c.keys().hasAll(['apiKey','authDomain','projectId','storageBucket','messagingSenderId','appId'])
        && c.apiKey is string && c.apiKey.size() > 0 && c.apiKey.size() <= 300
        && c.authDomain is string && c.authDomain.size() <= 300 && c.authDomain.matches('^[A-Za-z0-9.-]+[.][A-Za-z]{2,}$')
        && c.projectId is string && c.projectId.matches('^[a-z][a-z0-9-]{4,28}[a-z0-9]$') && c.projectId != 'sqysystems-faa0e'
        && c.storageBucket is string && c.storageBucket.size() > 0 && c.storageBucket.size() <= 300
        && c.messagingSenderId is string && c.messagingSenderId.size() <= 300 && c.messagingSenderId.matches('^[0-9]+$')
        && c.appId is string && c.appId.size() <= 300 && c.appId.matches('^1:[0-9]+:web:[A-Za-z0-9]+$');
    }
    function validStore(data, storeId) {
      return data.keys().hasOnly(['merchantEmail','storeName','storeApiBaseUrl','plan','status','firebaseConfig','updatedAt'])
        && data.keys().hasAll(['merchantEmail','storeName','storeApiBaseUrl','plan','status','firebaseConfig','updatedAt'])
        && validEmail(data.merchantEmail) && data.merchantEmail == storeId && data.merchantEmail == data.merchantEmail.lower()
        && data.storeName is string && data.storeName.size() > 0 && data.storeName.size() <= 80
        && data.storeApiBaseUrl is string && data.storeApiBaseUrl.size() <= 500
        && data.storeApiBaseUrl.matches('^https://[A-Za-z0-9-]+([.][A-Za-z0-9-]+)+$')
        && data.plan is string && data.plan.size() > 0 && data.plan.size() <= 120
        && data.status in ['active','disabled','deleted'] && validWebConfig(data.firebaseConfig)
        && data.updatedAt == request.time;
    }
    function validPayment(data) {
      return data.keys().hasOnly(['clientEmail','clientName','packageDetails','amountCents','currency','status','source','paidAt','createdBy','createdAt','updatedAt'])
        && data.keys().hasAll(['clientEmail','clientName','packageDetails','amountCents','currency','status','source','paidAt','createdBy','createdAt','updatedAt'])
        && validEmail(data.clientEmail) && data.clientEmail == data.clientEmail.lower()
        && data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 100
        && data.packageDetails is string && data.packageDetails.size() > 0 && data.packageDetails.size() <= 2000
        && data.amountCents is int && data.amountCents > 0 && data.amountCents <= 100000000
        && data.currency == 'EUR' && data.status in ['paid','refunded','cancelled'] && data.source == 'manual'
        && data.paidAt is timestamp && data.createdBy is string && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }
    function projectText(value, maxLength, required) {
      return value is string && value.size() <= maxLength && (!required || value.size() > 0);
    }
    function validProjectScope(d) {
      return d.selectedFeatures is list && d.selectedFeatures.size() <= 6
        && d.selectedFeatures.toSet().size() == d.selectedFeatures.size()
        && (
        (d.category == 'websites' && d.subType in ['E-Commerce Store','Informative / Corporate Website','Booking / Service Platform','Landing Page / Portfolio']
          && d.selectedFeatures.hasOnly(['Viva Wallet / Online Payments','Multi-language (GR/EN)','Cloud Drive / R2 Media','Courier Tracking (ACS/BoxNow/ELTA)','Custom Admin Panel','SEO & Analytics']))
        ||         (d.category == 'applications' && d.subType in ['Web Application / SaaS','Client Portal / Dashboard','Mobile App','Internal Business Tool']
          && d.selectedFeatures.hasOnly(['User Auth & Roles','Real-time Database','Subscriptions / Payments','Notifications','File Storage']))
        ||         (d.category == 'backend' && d.subType in ['Database Migration','Custom API','Cloud Architecture','Automation / Integration','Internal IT System']
          && d.selectedFeatures.hasOnly(['Firebase / Cloud Architecture','Third-party Integrations','Workflow Automation','Data Migration','Monitoring & Security']))
        ||         (d.category == 'design' && d.subType in ['Full Redesign','Design System','Wireframes / Prototype','Brand Experience','Conversion Optimization']
          && d.selectedFeatures.hasOnly(['User Research','Interactive Prototype','Responsive Design','Accessibility','Brand Guidelines']))
        );
    }
    function validProjectRequest(d) {
      return d.keys().hasOnly(['uid','clientName','clientEmail','clientPhone','company','category','subType','profession','productsOrServices','estimatedScale','selectedFeatures','projectName','preferredColors','aestheticStyle','timeline','notes','status','createdAt'])
        && d.keys().hasAll(['uid','clientName','clientEmail','clientPhone','company','category','subType','profession','productsOrServices','estimatedScale','selectedFeatures','projectName','preferredColors','aestheticStyle','timeline','notes','status','createdAt'])
        && projectText(d.clientName,100,true) && d.clientName.size() >= 2
        && validEmail(d.clientEmail) && d.clientEmail == d.clientEmail.lower()
        && projectText(d.clientPhone,40,false)
        && (d.clientPhone == '' || d.clientPhone.matches('^[+0-9().\\s-]{5,40}$'))
        && projectText(d.company,120,false)
        && (d.uid == null || (d.uid is string && d.uid.size() <= 128 && isOwner(d.uid)
          && d.clientEmail == request.auth.token.email.lower()))
        && validProjectScope(d)
        && projectText(d.profession,200,true) && projectText(d.productsOrServices,2000,true)
        && d.estimatedScale in ['1-20','20-100','100+','Not sure']
        && projectText(d.projectName,120,true) && projectText(d.preferredColors,300,true)
        && d.aestheticStyle in ['Minimalist','Luxury','Corporate','Bold'] && d.timeline in ['Urgent / ASAP','1–3 Months','Flexible']
        && projectText(d.notes,3000,false) && d.status == 'new' && d.createdAt == request.time;
    }
    match /project_requests/{requestId} {
      allow create: if validProjectRequest(request.resource.data);
      allow read: if isSuperAdmin() || (resource.data.uid != null && isOwner(resource.data.uid));
      // Submitted answers, client identity and creation time are immutable.
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['new','in_review','approved','archived']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSuperAdmin();
    }
    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && (!('role' in request.resource.data) || request.resource.data.role == 'client')
        && !request.resource.data.keys().hasAny(['tenantStore','storeSlug']);
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','tenantStore','storeSlug']);
      allow delete: if false;
    }
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','message','uid','createdAt','source'])
        && request.resource.data.keys().hasAll(['name','email','message','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && validEmail(request.resource.data.email) && request.resource.data.email.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt == request.time
        && (!('uid' in request.resource.data) || request.resource.data.uid == null
          || (request.auth != null && request.resource.data.uid == request.auth.uid))
        && (!('source' in request.resource.data) || (request.resource.data.source is string && request.resource.data.source.size() <= 100));
      allow read, delete: if isSuperAdmin();
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['unread','read','resolved']
        && request.resource.data.updatedAt == request.time;
    }
    match /client_payments/{paymentId} {
      allow read, delete: if isSuperAdmin();
      allow create: if isSuperAdmin() && validPayment(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if isSuperAdmin() && validPayment(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /merchant_stores/{storeId} {
      // Only public WEB configuration is stored in this get-readable record.
      // The router must be able to confirm whether a managed connection exists.
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && validStore(request.resource.data, storeId);
      allow delete: if isSuperAdmin();
    }
    match /store_directory/{storeId} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
